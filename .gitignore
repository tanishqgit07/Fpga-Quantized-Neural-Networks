KDDTest+.txt

# Archives / bundles sent between teammates
*.zip
*.tar.gz

# Packaging output from board/package_for_board.ps1
board_pkg/

# Prebuilt, board-tested bundles ARE committed (bitstreams + their test data)
!prebuilt/**
